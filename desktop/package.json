{
  "name": "internal-ai-desktop",
  "productName": "Internal AI",
  "version": "1.0.0",
  "description": "Internal AI desktop app",
  "private": true,
  "main": "main.js",
  "author": "Internal AI",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.mjs",
    "dist:mac": "npm run icons && electron-builder --mac dmg zip --arm64 --x64",
    "dist:win": "npm run icons && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "io.naar.internal-ai",
    "productName": "Internal AI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Internal AI uses the microphone for Echo dictation and the meeting assistant.",
        "NSScreenCaptureUsageDescription": "Internal AI captures your screen only when you ask it to, so the assistant can see what you see."
      }
    },
    "win": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}

# Configure these as server-side runtime secrets for live model responses.
# AI_GATEWAY_URL must be your approved HTTPS OpenAI-compatible gateway base URL.
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
AI_MODEL=
# Comma-separated exact hostnames permitted for MCP servers. No wildcard hosts.
MCP_ALLOWED_HOSTS=
# Optional server credentials use MCP_TOKEN_<SERVER_ID> (uppercase, hyphens become underscores).
# Vercel sign-in (not used on ChatGPT Sites). Everyone signs in with a one-time
# code emailed to them. AUTH_EMAIL is the workspace admin; they add teammates in
# Settings → Team. AUTH_SECRET signs sessions and codes: use a long random value
# (e.g. `openssl rand -hex 32`); changing it signs everyone out.
# Organisation domains whose people can sign in without being added first.
ALLOWED_EMAIL_DOMAINS=naar.io,nextgentechs.io
AUTH_EMAIL=
AUTH_NAME=
AUTH_SECRET=
# Firebase email-link sign-in (Google sends the email). Public values from the
# Firebase console → Project settings → Your apps → Web app. Enable
# Authentication → Sign-in method → Email/Password → "Email link", and add
# your site to Authentication → Settings → Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Sign-in emails (6-digit codes). Option 1 (recommended for Microsoft 365): Microsoft Graph with
# an Entra app that has the Mail.Send application permission (admin consented).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MAIL_FROM="Internal AI <no-reply@your-company.com>"
# Option 2: SMTP. Port 587 uses STARTTLS; set SMTP_SECURE=true for 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Internal AI <no-reply@your-company.com>"

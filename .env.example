# Configure these as server-side runtime secrets for live model responses.
# AI_GATEWAY_URL must be your approved HTTPS OpenAI-compatible gateway base URL.
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
AI_MODEL=
# Comma-separated exact hostnames permitted for MCP servers. No wildcard hosts.
MCP_ALLOWED_HOSTS=
# Optional server credentials use MCP_TOKEN_<SERVER_ID> (uppercase, hyphens become underscores).
# Vercel sign-in (not used on ChatGPT Sites). Everyone signs in with a one-time
# code emailed to them. AUTH_EMAIL is the workspace admin; they add teammates in
# Settings → Team. AUTH_SECRET signs sessions and codes: use a long random value
# (e.g. `openssl rand -hex 32`); changing it signs everyone out.
# Organisation domains whose people can sign in without being added first.
ALLOWED_EMAIL_DOMAINS=naar.io,nextgentechs.io
AUTH_EMAIL=
AUTH_NAME=
AUTH_SECRET=
# SMTP for sign-in emails. Port 587 uses STARTTLS; set SMTP_SECURE=true for 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Internal AI <no-reply@your-company.com>"
